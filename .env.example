# Copy to .env and adjust. Every variable is optional except the API key in production.
PULSEWATCH_API_KEY=replace-with-a-long-random-string
PULSEWATCH_DATABASE_URL=sqlite+aiosqlite:///./data/pulsewatch.db
# PULSEWATCH_DATABASE_URL=postgresql+asyncpg://pulsewatch:pulsewatch@db:5432/pulsewatch

PULSEWATCH_STATUS_PAGE_TITLE=Service Status
PULSEWATCH_FAILURE_THRESHOLD=2

# Alerts (any combination)
PULSEWATCH_WEBHOOK_URL=
PULSEWATCH_TELEGRAM_BOT_TOKEN=
PULSEWATCH_TELEGRAM_CHAT_ID=
